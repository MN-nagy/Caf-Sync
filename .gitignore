# Ignore huge dependency folders anywhere in the project
node_modules/

# Ignore sensitive environment variables
**/.env
.env.local
.env.*
.env

# Ignore Next.js frontend build outputs
.next/
out/

# Ignore Express backend build outputs
dist/
build/

# Platform CLI local config (not secrets, but shouldn't be committed)
.vercel/
.railway/

# TypeScript build cache
*.tsbuildinfo

# Misc
*.log
.DS_Store
